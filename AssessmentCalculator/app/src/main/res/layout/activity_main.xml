<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Simple Assessment Calculator!"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="5dp"
        android:background="@color/cyan"
        android:textColor="@color/white"
        android:layout_marginBottom="10dp"
             />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Formative Assessment (Online) Mark:"
        android:gravity="center"
        android:id="@+id/edtNum1"
        android:layout_marginBottom="10dp" />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Summative Assessment (Exam) Mark:"
        android:gravity="center"
        android:layout_marginBottom="10dp"
        android:id="@+id/edtnum2" />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Formative Project Mark:"
        android:gravity="center"
        android:layout_marginBottom="10dp"
        android:id="@+id/edtNum3" />
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >

    <Button
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:id="@+id/btnCal"
        android:layout_weight="1"
        android:text="Final Average %" />

    <Button
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:id="@+id/btnAvrg"
        android:layout_weight="1"
        android:text="CAS Average %" />

    </LinearLayout>

<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Result:"
    android:id="@+id/txtResult"
    android:textSize="20sp"
    android:gravity="center"
    android:textStyle="bold"
    android:layout_marginTop="10dp"
    android:padding="5sp" />

</LinearLayout>